{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": "allow",
    "task": "ask",
    "skill": "ask",
    "lsp": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "allow",
    "todowrite": "allow",
    "external_directory": "deny",
    "doom_loop": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20480
  },
